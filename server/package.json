{
  "name": "dear-blueno-server",
  "version": "0.1.0",
  "description": "Backend server for the Dear Blueno web app",
  "main": "src/index.ts",
  "scripts": {
    "start": "node dist/dev.js",
    "dev": "nodemon --exec ts-node src/dev.ts",
    "build": "tsc && cp src/jobs/loadSheets.cjs dist/jobs/loadSheets.cjs",
    "test": "jest --testPathPattern=src/tests/integration --runInBand",
    "test:parallel": "jest --testPathPattern=src/tests/integration",
    "test:build": "jest --testPathPattern=dist/tests/integration",
    "build:test": "npm run build && npm run test:build",
    "test:e2e": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "lint": "eslint . --max-warnings=0 && prettier -c .",
    "lint:fix": "eslint --fix . && prettier -w .",
    "db:indexes": "ts-node src/config/indexes.ts",
    "db:migrate": "node scripts/migration.mjs",
    "db:initialize-daily": "ts-node src/config/initializeDaily.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dear-Blueno/dearblueno.git"
  },
  "jest": {
    "preset": "ts-jest",
    "transform": {
      "^.+\\.tsx?$": "ts-jest",
      "^.+\\.js$": "<rootDir>/scripts/jest-esm-transform.cjs"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!ky/)"
    ],
    "testTimeout": 120000
  },
  "keywords": [
    "blueno",
    "brown",
    "university"
  ],
  "author": "Dear Blueno Team",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/Dear-Blueno/dearblueno/issues"
  },
  "homepage": "https://dearblueno.net",
  "devDependencies": {
    "@types/cookie-parser": "^1.4.2",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/express-session": "^1.17.4",
    "@types/jest": "^29.5.14",
    "@types/passport": "^1.0.9",
    "@types/passport-google-oauth20": "^2.0.11",
    "@types/response-time": "^2.3.5",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^5.30.7",
    "@typescript-eslint/parser": "^5.30.7",
    "eslint": "^8.20.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^2.7.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.4.0",
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0",
    "mongodb-memory-server": "^10.3.0"
  },
  "dependencies": {
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.1.0",
    "express-session": "^1.17.2",
    "express-validator": "^6.13.0",
    "google-spreadsheet": "^5.3.0",
    "log4js": "^6.4.1",
    "mongoose": "^8.24.7",
    "passport": "^0.6.0",
    "passport-google-oauth20": "^2.0.0",
    "response-time": "^2.3.2",
    "tslib": "^2.3.1",
    "express-async-errors": "^3.1.1",
    "mongodb": "6.20.0",
    "google-auth-library": "^10.5.0"
  },
  "engines": {
    "node": "24.x"
  }
}
